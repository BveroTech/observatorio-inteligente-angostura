#!/bin/bash
# Se ejecuta al instalar o actualizar el paquete (como root).
set -u
APP=/opt/observatorio-angostura
DEFAULT=/etc/default/observatorio-angostura
[ "${1:-}" = "configure" ] || exit 0

paso() { echo; echo "== Observatorio: $* =="; }

# --- Usuario del kiosco (dueño de los datos; con su sesión gráfica corre el kiosco)
USUARIO=""
[ -f "$DEFAULT" ] && . "$DEFAULT" && USUARIO="${OBSERVATORIO_USUARIO:-}"
[ -z "$USUARIO" ] && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ] && USUARIO="$SUDO_USER"
[ -z "$USUARIO" ] && [ -n "${PKEXEC_UID:-}" ] && USUARIO="$(getent passwd "$PKEXEC_UID" | cut -d: -f1)"
[ -z "$USUARIO" ] && USUARIO="$(getent passwd 1000 | cut -d: -f1)"
if [ -z "$USUARIO" ] || ! id "$USUARIO" >/dev/null 2>&1; then
    echo "[ERROR] No se encontró el usuario del kiosco. Indícalo en $DEFAULT (OBSERVATORIO_USUARIO=nombre)"
    echo "        y ejecuta: sudo dpkg-reconfigure observatorio-angostura"
    exit 1
fi
cat > "$DEFAULT" <<CONF
# Usuario que ejecuta el kiosco y el portal del Observatorio (dueño de $APP/data).
# Para cambiarlo: editar y ejecutar  sudo dpkg-reconfigure observatorio-angostura
OBSERVATORIO_USUARIO=$USUARIO
CONF
echo "Usuario del kiosco: $USUARIO"

# --- Entorno de Python (con los paquetes del sistema: OpenCV y TensorRT de JetPack)
paso "librerías de Python (sin internet, desde el paquete)"
if [ -d "$APP/.venv" ] && ! "$APP/.venv/bin/python" -c "import sys" 2>/dev/null; then rm -rf "$APP/.venv"; fi
[ -d "$APP/.venv" ] || python3 -m venv --system-site-packages "$APP/.venv" || { echo "[ERROR] No se pudo crear $APP/.venv"; exit 1; }
echo "Python del sistema: $("$APP/.venv/bin/python" --version 2>&1)"
if ! "$APP/.venv/bin/python" -m pip install --no-index --find-links "$APP/paquetes_python/comunes" \
        -r "$APP/requirements-jetson.txt" --disable-pip-version-check -q 2>/dev/null; then
    echo "[AVISO] El paquete no trae estas librerías para esta versión de Python; se descargan de internet..."
    "$APP/.venv/bin/python" -m pip install -r "$APP/requirements-jetson.txt" --disable-pip-version-check -q \
        || { echo "[ERROR] pip no pudo instalar las librerías (ver mensajes arriba)."; exit 1; }
fi

paso "ONNX Runtime (IA) según el Python y la CUDA de esta placa"
bash "$APP/scripts/jetson/instalar_onnxruntime.sh" "$APP/.venv/bin/python" "$APP/paquetes_python" \
    || { echo "[ERROR] No se pudo instalar ONNX Runtime (ver mensajes arriba)."; exit 1; }

if ! "$APP/.venv/bin/python" -c "import cv2" 2>/dev/null; then
    echo "[AVISO] Falta el OpenCV del sistema. Se instala el de PyPI (sin GStreamer: el RTSP usará FFmpeg)."
    echo "        Para decodificación por hardware: sudo apt install nvidia-opencv (JetPack) o python3-opencv, y reinstalar."
    "$APP/.venv/bin/python" -m pip install --disable-pip-version-check -q opencv-python-headless "numpy<2" \
        || echo "[ERROR] Sin OpenCV no hay video. Instalar: sudo apt install python3-opencv"
fi

# --- Permisos: el usuario del kiosco escribe datos, fotos y sonidos (portal)
mkdir -p "$APP/data"
chown -R "$USUARIO": "$APP"
chmod +x "$APP"/scripts/jetson/*.sh

paso "base de datos"
runuser -u "$USUARIO" -- "$APP/.venv/bin/python" "$APP/scripts/cli_admin/crear_base_datos.py" || echo "[AVISO] No se pudo preparar la base de datos."

fc-cache -f >/dev/null 2>&1 || true
command -v update-desktop-database >/dev/null && update-desktop-database -q /usr/share/applications || true
command -v gtk-update-icon-cache >/dev/null && gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true

# --- Servicios: portal (sistema) y kiosco (sesión gráfica del usuario)
paso "servicios"
mkdir -p /etc/systemd/system/observatorio-admin.service.d /etc/systemd/user/observatorio-kiosco.service.d
printf '[Service]\nUser=%s\n' "$USUARIO" > /etc/systemd/system/observatorio-admin.service.d/usuario.conf
printf '[Unit]\nConditionUser=%s\n' "$USUARIO" > /etc/systemd/user/observatorio-kiosco.service.d/usuario.conf
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable observatorio-admin.service >/dev/null 2>&1
    systemctl restart observatorio-admin.service && echo "Portal de administración: activo (puerto 5000)."
fi
systemctl --global enable observatorio-kiosco.service >/dev/null 2>&1 && echo "Kiosco: se abrirá solo al iniciar la sesión de $USUARIO."

if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw allow 5000/tcp >/dev/null && echo "Firewall: puerto 5000 abierto para el portal."
fi

paso "verificación"
"$APP/.venv/bin/python" - <<'PY' || true
import re, sqlite3, sys
print("Python", sys.version.split()[0], "| SQLite", sqlite3.sqlite_version)
try:
    import cv2
    gst = re.search(r"GStreamer:\s+YES", cv2.getBuildInformation())
    print("OpenCV", cv2.__version__, "| GStreamer:", "sí" if gst else "NO (el RTSP usará FFmpeg, sin decodificación por hardware)")
except Exception as e:
    print("[AVISO] OpenCV no disponible:", e, "-> instalar el OpenCV de JetPack: sudo apt install nvidia-opencv")
try:
    import onnxruntime as ort
    print("ONNX Runtime", ort.__version__, "| proveedores:", ", ".join(ort.get_available_providers()))
except Exception as e:
    print("[AVISO] ONNX Runtime:", e)
PY

cat <<FIN

Observatorio instalado en $APP
  1. Crear el usuario del portal:   observatorio-usuario
  2. Elegir los monitores:          menú > "Observatorio · Configurar pantallas"
  3. Abrir:                         menú > "Observatorio de Aves"  (o el comando: observatorio)
  Portal desde otro computador:     http://$(hostname):5000
  Para que el kiosco abra solo al encender, activar el inicio de sesión automático de $USUARIO
  (Configuración > Usuarios) y usar la sesión "Ubuntu on Xorg".
FIN
exit 0
